# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider (optional - app falls back to mock if not set)
AI_PROVIDER=openai   # openai | anthropic | together | kie | mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Together AI (Primary Open Models)
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# KIE AI (Alternative endpoint)
KIE_API_KEY=
KIE_MODEL=
KIE_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Additional Services
TAVILY_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
FAL_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
